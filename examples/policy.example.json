{
  "secrets": {
    "example-api-key": { "allowed_hosts": ["httpbin.org"] },
    "example-echo-key": { "allowed_hosts": ["postman-echo.com"] },
    "example-login": { "allowed_hosts": ["*.example.com"] },
    "github-*": { "allowed_hosts": ["api.github.com", "github.com"] },
    "example-aws-reports": {
      "allowed_hosts": ["example-reports-bucket.s3.us-east-1.amazonaws.com", "sts.us-east-1.amazonaws.com"],
      "signing": "aws-sigv4"
    },
    "example-ledger": {
      "allowed_hosts": ["ledger"],
      "signing": {
        "type": "hmac",
        "hash": "sha256",
        "key_header": "X-Ledger-Key",
        "signature_header": "X-Ledger-Signature",
        "encoding": "base64",
        "message": ["header:X-Ledger-Timestamp", "method", "path_query", "body"]
      }
    }
  },
  "shared": {
    "browserbase-api-key": { "allowed_hosts": ["api.browserbase.com"], "swap_headers": ["X-BB-API-Key"] }
  }
}
