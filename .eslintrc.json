{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": [
    "@typescript-eslint"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "env": {
    "node": true,
    "es2022": true
  },
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/no-explicit-any": "warn",
    "no-restricted-properties": [
      "error",
      {
        "object": "process",
        "property": "env",
        "message": "Read configuration in packages/core/src/config.ts (or the bin, cli.ts) and pass it down; providers get env via ProviderContext."
      }
    ]
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    ".turbo"
  ],
  "overrides": [
    {
      "files": [
        "packages/core/src/cli.ts",
        "packages/core/src/config.ts"
      ],
      "rules": {
        "no-restricted-properties": "off"
      }
    }
  ]
}
