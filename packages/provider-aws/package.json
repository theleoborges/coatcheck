{
  "name": "@coatcheck/provider-aws",
  "version": "0.1.0",
  "description": "coatcheck secret provider: AWS SSM Parameter Store (per-agent) and Secrets Manager (shared), with optional STS AssumeRole.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theleoborges/coatcheck.git",
    "directory": "packages/provider-aws"
  },
  "homepage": "https://github.com/theleoborges/coatcheck#readme",
  "bugs": {
    "url": "https://github.com/theleoborges/coatcheck/issues"
  },
  "keywords": [
    "coatcheck",
    "secrets",
    "aws",
    "ssm",
    "parameter-store",
    "secrets-manager",
    "sts",
    "assume-role",
    "ai-agents"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@coatcheck/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "peerDependencies": {
    "@coatcheck/core": "^0.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.600.0",
    "@aws-sdk/client-ssm": "^3.600.0",
    "@aws-sdk/client-sts": "^3.600.0"
  }
}
