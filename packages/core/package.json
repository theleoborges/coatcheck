{
  "name": "@coatcheck/core",
  "version": "0.1.0",
  "description": "Credential broker for AI agents: agents hold short-lived tickets, real secrets are swapped in on the wire (HTTPS + browser/CDP).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theleoborges/coatcheck.git",
    "directory": "packages/core"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "coatcheck": "dist/cli.js"
  },
  "exports": {
    ".": {
      "@coatcheck/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "dependencies": {
    "@peculiar/x509": "2.1.0",
    "reflect-metadata": "0.2.2",
    "ws": "^8.18.0"
  }
}
