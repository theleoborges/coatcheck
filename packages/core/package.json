{
  "name": "@coatcheck/core",
  "version": "0.2.0",
  "description": "Credential broker for AI agents: agents hold short-lived tickets, real secrets are swapped in on the wire (HTTPS + browser/CDP).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theleoborges/coatcheck.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/theleoborges/coatcheck#readme",
  "bugs": {
    "url": "https://github.com/theleoborges/coatcheck/issues"
  },
  "keywords": [
    "secrets",
    "credentials",
    "credential-broker",
    "ai-agents",
    "agents",
    "proxy",
    "https-proxy",
    "mitm",
    "cdp",
    "playwright",
    "browser-automation",
    "sidecar",
    "security"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "coatcheck": "dist/cli.js"
  },
  "exports": {
    ".": {
      "@coatcheck/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "dependencies": {
    "@peculiar/x509": "2.2.0",
    "reflect-metadata": "0.2.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
