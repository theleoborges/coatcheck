{
  "name": "@coatcheck/provider-env",
  "version": "0.1.0",
  "description": "coatcheck secret providers with no cloud dependency: environment variables (`.`) and a JSON file (`./file`).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theleoborges/coatcheck.git",
    "directory": "packages/provider-env"
  },
  "homepage": "https://github.com/theleoborges/coatcheck#readme",
  "bugs": {
    "url": "https://github.com/theleoborges/coatcheck/issues"
  },
  "keywords": [
    "coatcheck",
    "secrets",
    "environment-variables",
    "json",
    "ai-agents"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@coatcheck/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./file": {
      "@coatcheck/source": "./src/file.ts",
      "types": "./dist/file.d.ts",
      "default": "./dist/file.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "peerDependencies": {
    "@coatcheck/core": "^0.1.0"
  }
}
