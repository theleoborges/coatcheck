{
  "name": "coatcheck-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/core",
    "packages/provider-aws",
    "packages/provider-env"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx --conditions=@coatcheck/source packages/core/src/cli.ts",
    "lint": "eslint packages/*/src",
    "type-check": "tsc -b",
    "test": "vitest run",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.5"
  }
}
